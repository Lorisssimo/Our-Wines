# WARNING: 123456 is an intentionally insecure placeholder. Production startup
# refuses it while authentication is enabled. Replace it with a strong password.
NODE_ENV=development
PORT=3000
APP_PUBLIC_URL=http://localhost:3000
DATA_DIR=./data
# Host path used by Docker Compose. On Unraid, use an absolute appdata path.
HOST_DATA_DIR=./data
AUTH_ENABLED=true
AUTH_PASSWORD=123456
AUTH_SESSION_DAYS=30
SCORE_WEIGHT_OVERALL=8
SCORE_WEIGHT_TASTE=6
SCORE_WEIGHT_AFTERTASTE=3
SCORE_WEIGHT_SWEETNESS=3
MAX_UPLOAD_MB=8
